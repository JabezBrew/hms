# API base URL
# In dev, Vite proxy often maps `/api` to the backend.
# VITE_API_BASE_URL=http://localhost:8000/api

# Rust V2 API mode keeps this JS/Vite UI and routes selected helpers to /api/v2.
# VITE_HMS_API_MODE=rust-v2
# VITE_V2_API_BASE_URL=/api/v2
# VITE_V2_API_PROXY_TARGET=http://localhost:8080

# Optional explicit WebSocket base URL (overrides automatic resolution)
# VITE_WS_URL=ws://localhost:8000

# Optional browser RUM collection. Defaults off unless this or runtime config
# __HMS_RUNTIME_CONFIG__.rumEnabled is set truthy.
# VITE_RUM_ENABLED=false

# Optional local defaults for facility-aware development
# VITE_DEFAULT_FACILITY_CODE=MAIN
# VITE_MULTI_FACILITY_MODE=false           # Local fallback; backend deployment capabilities are authoritative
