{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:ci": "serve -s dist -l 4173",
    "api:v2:generate": "node ./scripts/generate-v2-api-client.mjs",
    "api:v2:generate:check": "node ./scripts/generate-v2-api-client.mjs --check",
    "e2e": "playwright test",
    "e2e:list": "playwright test --list",
    "perf:bundle-budget": "node ./scripts/check-bundle-budget.mjs",
    "perf:runtime": "node ./scripts/measure-runtime-perf.mjs",
    "perf:lhci": "npx -y @lhci/cli@0.13.x autorun --config=.lighthouserc.json",
    "perf:ci": "npm run build && npm run perf:bundle-budget",
    "analyze": "vite build --mode analyze",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "doctor": "react-doctor"
  },
