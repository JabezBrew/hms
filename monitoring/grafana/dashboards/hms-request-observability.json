{
  "uid": "hms-request-observability",
  "title": "HMS Request Observability",
  "tags": ["hms", "observability", "requests"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "client",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "query": "label_values(up, client)",
        "current": { "text": "All", "value": "$__all" },
        "includeAll": true,
        "multi": true
      },
      {
        "name": "environment",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "query": "label_values(up, environment)",
        "current": { "text": "All", "value": "$__all" },
        "includeAll": true,
        "multi": true
      },
      {
        "name": "route",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "query": "label_values(hms_http_requests_total{client=~\"$client\",environment=~\"$environment\"}, route)",
        "current": { "text": "All", "value": "$__all" },
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Request Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (status_class) (rate(hms_http_requests_total{client=~\"$client\",environment=~\"$environment\",route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "{{status_class}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "5xx Error Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(hms_http_requests_total{client=~\"$client\",environment=~\"$environment\",route=~\"$route\",status_code=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(hms_http_requests_total{client=~\"$client\",environment=~\"$environment\",route=~\"$route\"}[$__rate_interval])), 0.001)",
          "legendFormat": "5xx ratio"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] }
    },
    {
      "id": 3,
      "title": "API Latency",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 7 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(hms_http_request_duration_seconds_bucket{client=~\"$client\",environment=~\"$environment\",route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(hms_http_request_duration_seconds_bucket{client=~\"$client\",environment=~\"$environment\",route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(hms_http_request_duration_seconds_bucket{client=~\"$client\",environment=~\"$environment\",route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 4,
      "title": "Slowest Routes",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "targets": [
        {
          "expr": "topk(10, histogram_quantile(0.95, sum by (route, le) (rate(hms_http_request_duration_seconds_bucket{client=~\"$client\",environment=~\"$environment\"}[$__rate_interval]))) > 0)",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 5,
      "title": "Top Failing Routes",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "targets": [
        {
          "expr": "topk(10, sum by (route, status_code) (rate(hms_http_requests_total{client=~\"$client\",environment=~\"$environment\",status_code=~\"5..\"}[$__rate_interval])))",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Recent API Error Logs",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 23 },
      "targets": [
        {
          "expr": "{service=\"api\",client=~\"$client\",environment=~\"$environment\"} | json | status_code >= 500"
        }
      ]
    },
    {
      "id": 7,
      "title": "Container Restarts",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 33 },
      "targets": [
        {
          "expr": "sum by (container_label_com_docker_compose_service) (changes(container_start_time_seconds{client=~\"$client\",environment=~\"$environment\"}[15m]))",
          "legendFormat": "{{container_label_com_docker_compose_service}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Host Memory Available",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 33 },
      "targets": [
        {
          "expr": "node_memory_MemAvailable_bytes{client=~\"$client\",environment=~\"$environment\"} / node_memory_MemTotal_bytes{client=~\"$client\",environment=~\"$environment\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] }
    },
    {
      "id": 9,
      "title": "Redis Memory",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 33 },
      "targets": [
        {
          "expr": "redis_memory_used_bytes{client=~\"$client\",environment=~\"$environment\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    }
  ]
}
