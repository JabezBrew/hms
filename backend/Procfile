web: python manage.py collectstatic --noinput && python manage.py migrate && python manage.py ensure_admin && daphne --bind 0.0.0.0 --port $PORT --proxy-headers --access-log - --websocket_timeout -1 hms_backend.asgi:application
worker: celery -A hms_backend worker --loglevel=info
beat: celery -A hms_backend beat --loglevel=info
