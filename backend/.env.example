# Django settings
DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# Database settings
DB_NAME=hms
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Control-plane database (MPI/consent)
# Use DATABASE_URL format, or leave empty to reuse primary DB in dev
CONTROL_PLANE_DB_ALIAS=control
CONTROL_PLANE_DATABASE_URL=

# Facility context defaults
DEFAULT_FACILITY_CODE=MAIN
FACILITY_CONTEXT_REQUIRED=True
MULTI_FACILITY_MODE=False
ALLOW_CROSS_FACILITY_ACCESS=False

# MFA
MFA_REQUIRED_FOR_ADMIN=True
MFA_TOTP_ISSUER=HMS
MFA_SESSION_TTL_MINUTES=5
MFA_ENROLLMENT_TTL_MINUTES=30
MFA_ENCRYPTION_KEY=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=HMS
WEBAUTHN_ALLOWED_ORIGINS=http://localhost:5173
WEBAUTHN_TIMEOUT_MS=60000

# Cross-facility record export
RECORD_EXPORT_FERNET_KEY=

# Google Cloud Healthcare API
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/credentials.json
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_HEALTHCARE_DATASET=your-dataset-id
GOOGLE_FHIR_STORE=your-fhir-store-id
GOOGLE_DICOM_STORE=your-dicom-store-id
GOOGLE_HL7V2_STORE=your-hl7v2-store-id

# Email settings
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_USE_TLS=True

# CORS settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Access control
TEAM_ACCESS_STRICT=True
BREAK_GLASS_TTL_MINUTES=30
