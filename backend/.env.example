# ===========================================
# REQUIRED - No defaults, must be set
# ===========================================

# Django
SECRET_KEY=your-secret-key-here

# Database
DB_NAME=hms
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Email - SendGrid Web API
# Get your API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=your-verified-sender@example.com

# ===========================================
# OPTIONAL - Have sensible defaults
# ===========================================

# Django
# DEBUG=True
# PORT=8000
# ALLOWED_HOSTS=localhost,127.0.0.1

# Redis (for caching/Celery)
# REDIS_URL=redis://127.0.0.1:6379/1
# CELERY_TASK_IGNORE_RESULT=True
# CELERY_RESULT_EXPIRES=3600
# CELERY_BROKER_CONNECTION_RETRY=True
# CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP=True
# CELERY_BROKER_CONNECTION_MAX_RETRIES=100
# CELERY_BROKER_CONNECTION_TIMEOUT=8.0
# CELERY_BROKER_CHANNEL_ERROR_RETRY=True
# CELERY_BROKER_SOCKET_CONNECT_TIMEOUT=8.0
# CELERY_BROKER_SOCKET_TIMEOUT=30.0
# CELERY_BROKER_SOCKET_KEEPALIVE=True
# CELERY_BROKER_HEALTH_CHECK_INTERVAL=30
# CELERY_BROKER_RETRY_ON_TIMEOUT=True
# CELERY_REDIS_SOCKET_CONNECT_TIMEOUT=8.0
# CELERY_REDIS_SOCKET_TIMEOUT=30.0
# CELERY_REDIS_SOCKET_KEEPALIVE=True
# CELERY_REDIS_RETRY_ON_TIMEOUT=True
# CELERY_REDIS_BACKEND_HEALTH_CHECK_INTERVAL=30
# CELERY_RESULT_BACKEND_RETRY_ON_TIMEOUT=True
# CELERY_RESULT_BACKEND_HEALTH_CHECK_INTERVAL=30
# CELERY_WORKER_CANCEL_LONG_RUNNING_TASKS_ON_CONNECTION_LOSS=True
# CELERY_WORKER_CONCURRENCY=2
# CELERY_WORKER_PREFETCH_MULTIPLIER=1
# CELERY_WORKER_MAX_TASKS_PER_CHILD=200
# CELERY_WORKER_MAX_MEMORY_PER_CHILD=262144
# ADMIN_DASHBOARD_PREWARM_INTERVAL_SECONDS=0

# CORS
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# CORS_ALLOWED_ORIGIN_REGEXES=^https://(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)\.thehms\.systems$
# CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173
# Railway frontend origins to include in both CORS and CSRF trusted origins
# RAILWAY_FRONTEND_ORIGINS=https://frontend-staging-e202.up.railway.app,https://frontend-production-40e0.up.railway.app

# Facility context
# DEFAULT_FACILITY_CODE=MAIN
# DEFAULT_FACILITY_NAME=Main Hospital
# DEFAULT_FACILITY_TYPE=hospital
# DEFAULT_FACILITY_ADDRESS=123 Health Avenue
# DEFAULT_FACILITY_CITY=Accra
# DEFAULT_FACILITY_REGION=Greater Accra
# DEFAULT_FACILITY_COUNTRY=Ghana
# DEFAULT_FACILITY_POSTAL_CODE=
# DEFAULT_FACILITY_PHONE=+233000000000
# DEFAULT_FACILITY_EMAIL=admin@mainhospital.example
# DEFAULT_FACILITY_TIMEZONE=Africa/Accra
# DEFAULT_FACILITY_CURRENCY=GHS
# DEFAULT_FACILITY_IS_HEADQUARTERS=True
# DEPLOYMENT_PROFILE=hospital              # clinic | hospital | hospital_network
# FEATURE_FLAG_OVERRIDES=                  # JSON or key=value pairs, e.g. {"laboratory": false}
# FACILITY_CONTEXT_REQUIRED=True           # Legacy override for feature: facility_context_required
# MULTI_FACILITY_MODE=False                # Legacy override for features: multi_facility, facility_switcher
# ALLOW_CROSS_FACILITY_ACCESS=False        # Legacy override for feature: cross_facility_access
# PRACTITIONER_SCHEDULING_MODE=roster      # Legacy override for feature: department_rosters
# REQUIRE_OUTPATIENT_ACTIVE_CLINIC=True    # Legacy override for feature: outpatient_active_clinic_required

# Startup/deploy behavior
# MIGRATE_ON_STARTUP=True                  # Recommended True for single-step Railway deploys
# FAIL_ON_PENDING_MIGRATIONS=True          # Keep True when MIGRATE_ON_STARTUP is disabled
# RUN_MIGRATIONS_ONLY=False                # Optional one-off migration-only run

# Public URL (used for PSP webhook callbacks behind proxies/load balancers)
# PUBLIC_BASE_URL=https://your-public-api.example.com

# Security transport defaults
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# MFA (defaults shown)
# MFA_REQUIRED_FOR_ADMIN=True
# MFA_REQUIRED_FOR_ALL=False
# MFA_TOTP_ISSUER=HMS
# MFA_SESSION_TTL_MINUTES=5
# MFA_ENCRYPTION_KEY=          # Optional: for encrypting TOTP secrets at rest

# WebAuthn (defaults shown)
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME=HMS
# WEBAUTHN_ALLOWED_ORIGINS=http://localhost:5173
# WEBAUTHN_ALLOWED_ORIGIN_REGEXES=^https://(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)\.thehms\.systems$

# ===========================================
# PRODUCTION ONLY - Not needed for local dev
# ===========================================

# Control-plane database (separate DB for MPI/consent in multi-facility)
# CONTROL_PLANE_DATABASE_URL=postgres://user:pass@host:5432/control_db

# Cross-facility record export
# RECORD_EXPORT_FERNET_KEY=    # Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# RECORD_EXPORT_TTL_HOURS=24   # Export payload TTL (hours). Used for NHIS Claim-it export ZIPs too.

# Billing / Finance
# BILLING_ENABLE_FHIR_CLAIMS=False
# BILLING_POST_INSURANCE_PAYMENTS_ON_CLAIM_APPROVAL=False

# AI Platform (defaults shown)
# AI_ENABLED=False
# AI_HOSTING_MODE=hybrid                 # managed | self_hosted | hybrid
# AI_PROVIDER=
# AI_PROVIDER_SECONDARY=
# AI_PROVIDER_BASE_URL=
# AI_PROVIDER_API_KEY=
# AI_PROVIDER_REGION=
# AI_PROVIDER_ZERO_RETENTION=True
# AI_PROVIDER_PRIVATE_NETWORK_ENABLED=False
# AI_MODEL_REASONER_PRIMARY=reasoner-primary
# AI_MODEL_REASONER_FALLBACK=reasoner-fallback
# AI_MODEL_WRITER_PRIMARY=writer-primary
# AI_MODEL_WRITER_FALLBACK=writer-fallback
# AI_MODEL_VALIDATOR=validator-small
# AI_MODEL_INTENT=intent-small
# AI_MODEL_ASR_PRIMARY=asr-primary
# AI_MODEL_ASR_FALLBACK=asr-fallback
# AI_MODEL_EMBEDDING=embedding-model
# AI_MODEL_RERANKER=reranker-model
# AI_VECTOR_BACKEND=pgvector             # pgvector | external
# AI_VECTOR_INDEX_URL=
# AI_OBJECT_STORAGE_BUCKET_AUDIO=
# AI_OBJECT_STORAGE_BUCKET_TRANSCRIPTS=
# AI_OBJECT_STORAGE_KMS_KEY_ID=
# AI_REQUEST_TIMEOUT_MS=8000
# AI_REQUEST_TIMEOUT_ASR_MS=20000
# AI_MAX_CONTEXT_TOKENS=12000
# AI_MAX_OUTPUT_TOKENS=1600
# AI_MAX_AUDIO_CHUNK_SECONDS=20
# AI_SCRIBE_REALTIME_QUEUE=ai_realtime
# AI_BATCH_QUEUE=ai_batch
# AI_MAINTENANCE_QUEUE=ai_maintenance
# AI_AUDIO_RETENTION_DAYS=3
# AI_TRANSCRIPT_RETENTION_DAYS=30
# AI_MESSAGE_ENCRYPTION_KEY=
# AI_NO_TRAINING_ENFORCED=True
# AI_DAILY_SPEND_CAP_USD=200
# AI_CHRONICLE_COPILOT_ENABLED=False
# AI_NOTE_DRAFT_ENABLED=False
# AI_NOTE_LINT_ENABLED=False
# AI_AMBIENT_SCRIBE_ENABLED=False
# AI_LAB_INTERPRET_ENABLED=False
# AI_OMNI_NL_ENABLED=False
# AI_PATIENT_ASSIST_ENABLED=False

# Hubtel PSP (required for Mobile Money / card payment intents)
# HUBTEL_API_BASE_URL=https://api.hubtel.com
# HUBTEL_CLIENT_ID=
# HUBTEL_CLIENT_SECRET=
# HUBTEL_WEBHOOK_SECRET=       # Shared token expected on webhook URL query string: ?token=...
# HUBTEL_HTTP_TIMEOUT_SECONDS=8

# Google Cloud Healthcare API
# GOOGLE_APPLICATION_CREDENTIALS=path/to/credentials.json
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_HEALTHCARE_DATASET=your-dataset-id
# GOOGLE_FHIR_STORE=your-fhir-store-id
# GOOGLE_DICOM_STORE=your-dicom-store-id
# GOOGLE_HL7V2_STORE=your-hl7v2-store-id

# Access control
# TEAM_ACCESS_STRICT=True
# BREAK_GLASS_TTL_MINUTES=30
