# Copy this file to ops/hetzner-v2/.env on the client VPS.
# Never commit generated .env files or backup credentials.

# Compose/Caddy
VERSION=client
COMPOSE_PROJECT_NAME=hms-v2-client
CLIENT_SLUG=client
CLIENT_NAME=Client HMS V2
CLIENT_DOMAIN=client.thehms.systems
ACME_EMAIL=ops@thehms.systems

# Optional custom HMS ops dashboard route. Keep localhost until DNS points to
# this VPS and the dashboard enforces authenticated ops-only access.
OPS_DOMAIN=localhost
OPS_DASHBOARD_UPSTREAM=frontend:80

# Ops dashboard auth. Use cloudflare_access for the engineer-only ops subdomain.
# Cloudflare Access injects Cf-Access-Jwt-Assertion; hms-api verifies that JWT
# against your team domain and AUD before serving /api/v2/ops/*.
HMS_OPS_AUTH_MODE=hms_permission
HMS_CLOUDFLARE_ACCESS_TEAM_DOMAIN=
HMS_CLOUDFLARE_ACCESS_AUD=
HMS_CLOUDFLARE_ACCESS_ALLOWED_EMAILS=

# Legacy/fallback only: comma-separated existing HMS user emails that should
# receive platform-only ops dashboard access during provisioning. Leave empty
# when HMS_OPS_AUTH_MODE=cloudflare_access.
HMS_OPS_OPERATOR_EMAILS=

# Rust runtime
HMS_ENV=production
HMS_API_LISTEN_ADDR=0.0.0.0:8080
HMS_JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_64
HMS_COOKIE_SECURE=true
HMS_AUTO_MIGRATE=false
HMS_DATABASE_MAX_CONNECTIONS=10
HMS_REDIS_ADDR=redis:6379
HMS_RUM_ENABLED=false
HMS_OPS_PROMETHEUS_ENABLED=false
HMS_OPS_PROMETHEUS_URL=
HMS_OPS_PROMETHEUS_TIMEOUT_MS=1500
HMS_BUILD_SHA=
HMS_DEPLOYED_AT=
HMS_WORKER_DATABASE_MAX_CONNECTIONS=2
HMS_WORKER_POLL_INTERVAL_SECONDS=30
HMS_WORKER_METRICS_LISTEN_ADDR=0.0.0.0:8081
RUST_LOG=hms_api=info,hms_worker=info,hms_db=info

# Database
DB_NAME=hms
DB_USER=hms
DB_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_DEFAULT_POOL_SIZE=15
PGBOUNCER_RESERVE_POOL_SIZE=5
PG_STAT_STATEMENTS_MAX=10000

# Deployment profile and facility
# Supported profiles:
# chps_compound, health_center, clinic, hospital, district_hospital,
# regional_hospital, teaching_hospital, hospital_network.
HMS_DEPLOYMENT_PROFILE=hospital
HMS_FACILITY_CODE=MAIN
HMS_FACILITY_NAME=Client HMS
MULTI_FACILITY_MODE=false
FRONTEND_WS_URL=

# Baseline provisioning
HMS_PROVISION_BASELINE=true
HMS_BOOTSTRAP_ADMIN_EMAIL=admin@client.thehms.systems
HMS_BOOTSTRAP_ADMIN_NAME=HMS Administrator
HMS_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_generate_unique_admin_password
HMS_SEED_DEMO_DATA=false

# Private observability sidecars
PROMETHEUS_RETENTION=7d
GRAFANA_LOCAL_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_generate_unique_grafana_password

# Backups
BACKUP_RETENTION_DAYS=30
RESTIC_REPOSITORY=CHANGE_ME_s3_restic_repository
RESTIC_PASSWORD=CHANGE_ME_generate_restic_password
AWS_ACCESS_KEY_ID=CHANGE_ME_s3_access_key_id
AWS_SECRET_ACCESS_KEY=CHANGE_ME_s3_secret_access_key
