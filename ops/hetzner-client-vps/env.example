# Copy this file to .env in the same directory or generate one with:
# python3 ops/create-client-deployment.py --slug acme --name "Acme Clinic" \
#   --profile clinic --mode production --domain acme.thehms.systems \
#   --facility-code ACME --output ops/hetzner-client-vps/.env
#
# Never commit generated .env files or backup credentials.

# Compose/Caddy
VERSION=client
COMPOSE_PROJECT_NAME=hms-client
CLIENT_SLUG=client
CLIENT_NAME=Client HMS
CLIENT_DOMAIN=client.thehms.systems
DEPLOYMENT_MODE=demo
ACME_EMAIL=ops@thehms.systems

# Django core
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_64
ALLOWED_HOSTS=client.thehms.systems
CORS_ALLOWED_ORIGINS=https://client.thehms.systems
CSRF_TRUSTED_ORIGINS=https://client.thehms.systems
FRONTEND_URL=https://client.thehms.systems
PUBLIC_BASE_URL=https://client.thehms.systems

# Database
DB_NAME=hms
DB_USER=hms
DB_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_32

# Bootstrap facility/admin
DEFAULT_FACILITY_CODE=MAIN
DEFAULT_FACILITY_NAME=Client HMS
DEFAULT_FACILITY_TYPE=hospital
DEFAULT_FACILITY_ADDRESS=Client Address
DEFAULT_FACILITY_CITY=Accra
DEFAULT_FACILITY_REGION=Greater Accra
DEFAULT_FACILITY_COUNTRY=Ghana
DEFAULT_FACILITY_PHONE=+233000000000
DEFAULT_FACILITY_EMAIL=admin@client.thehms.systems
ADMIN_EMAIL=admin@client.thehms.systems
ADMIN_PASSWORD=CHANGE_ME_generate_unique_admin_password
ADMIN_FIRST_NAME=Client
ADMIN_LAST_NAME=Administrator

# Product profile and cost controls
DEPLOYMENT_PROFILE=hospital
FEATURE_FLAG_OVERRIDES=
AI_ENABLED=False
CELERY_WORKER_CONCURRENCY=1
CELERY_WORKER_PREFETCH_MULTIPLIER=1
ADMIN_DASHBOARD_PREWARM_INTERVAL_SECONDS=0
MULTI_FACILITY_MODE=false

# Security
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
MFA_ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_base64_32
RECORD_EXPORT_FERNET_KEY=CHANGE_ME_generate_urlsafe_base64_32_bytes
SESSION_HASH_SALT=CHANGE_ME_generate_with_openssl_rand_hex_32
WEBAUTHN_RP_ID=client.thehms.systems
WEBAUTHN_ALLOWED_ORIGINS=https://client.thehms.systems
MFA_TOTP_ISSUER=HMS Client

# Email. Production clients need a restricted sender key.
UNOSEND_API_KEY=CHANGE_ME_unosend_api_key
DEFAULT_FROM_EMAIL=noreply@client.thehms.systems

# Google Healthcare API is disabled unless explicitly configured.
GOOGLE_APPLICATION_CREDENTIALS=/dev/null
GOOGLE_CLOUD_PROJECT=client-disabled
GOOGLE_HEALTHCARE_DATASET=client-disabled
GOOGLE_FHIR_STORE=client-disabled
GOOGLE_DICOM_STORE=client-disabled
GOOGLE_HL7V2_STORE=client-disabled

# Backups
BACKUP_RETENTION_DAYS=7
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
