# Copy this file to .env in the same directory and fill every CHANGE_ME value.
# Keep staging fake-data only. Do not put real PHI on the CX23 staging box.

# Compose/Caddy
VERSION=staging
STAGING_DOMAIN=staging.example.com
ACME_EMAIL=ops@example.com

# Django core
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_64
ALLOWED_HOSTS=staging.example.com
CORS_ALLOWED_ORIGINS=https://staging.example.com
CSRF_TRUSTED_ORIGINS=https://staging.example.com
FRONTEND_URL=https://staging.example.com
PUBLIC_BASE_URL=https://staging.example.com

# Database
DB_NAME=hms
DB_USER=hms
DB_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_32

# Bootstrap facility/admin
DEFAULT_FACILITY_CODE=MAIN
DEFAULT_FACILITY_NAME=Staging Hospital
DEFAULT_FACILITY_TYPE=hospital
DEFAULT_FACILITY_ADDRESS=Staging Address
DEFAULT_FACILITY_CITY=Accra
DEFAULT_FACILITY_REGION=Greater Accra
DEFAULT_FACILITY_COUNTRY=Ghana
DEFAULT_FACILITY_PHONE=+233000000000
DEFAULT_FACILITY_EMAIL=admin@staging.example.com
ADMIN_EMAIL=admin@staging.example.com
ADMIN_PASSWORD=CHANGE_ME_generate_unique_staging_admin_password
ADMIN_FIRST_NAME=Staging
ADMIN_LAST_NAME=Administrator

# Staging cost controls
AI_ENABLED=False
CELERY_WORKER_CONCURRENCY=1
CELERY_WORKER_PREFETCH_MULTIPLIER=1
ADMIN_DASHBOARD_PREWARM_INTERVAL_SECONDS=0
MULTI_FACILITY_MODE=false
DEPLOYMENT_PROFILE=hospital

# Security
MFA_ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_base64_32
RECORD_EXPORT_FERNET_KEY=CHANGE_ME_generate_urlsafe_base64_32_bytes
SESSION_HASH_SALT=CHANGE_ME_generate_with_openssl_rand_hex_32
WEBAUTHN_RP_ID=staging.example.com
WEBAUTHN_ALLOWED_ORIGINS=https://staging.example.com
MFA_TOTP_ISSUER=HMS Staging

# Email. Use a restricted staging sender or a dummy key if email flows are not tested.
SENDGRID_API_KEY=CHANGE_ME_or_staging_dummy
DEFAULT_FROM_EMAIL=noreply@staging.example.com

# Google Healthcare API is disabled for cheap staging unless explicitly configured.
GOOGLE_APPLICATION_CREDENTIALS=/dev/null
GOOGLE_CLOUD_PROJECT=staging-disabled
GOOGLE_HEALTHCARE_DATASET=staging-disabled
GOOGLE_FHIR_STORE=staging-disabled
GOOGLE_DICOM_STORE=staging-disabled
GOOGLE_HL7V2_STORE=staging-disabled
